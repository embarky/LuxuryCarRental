# Copy this file to .env and adjust the values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- MySQL container ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=luxury_car_rental_db
MYSQL_USER=luxury_car_rental
MYSQL_PASSWORD=change-me

# --- Payara -> MySQL connection pool ---
DB_HOST=db
DB_PORT=3306
DB_NAME=luxury_car_rental_db
DB_USER=luxury_car_rental
DB_PASSWORD=change-me

# --- Webapp -> REST API (both run in the same Payara container) ---
API_BASE_URL=http://localhost:8080/luxurycarrental/api

# --- Demo data (seeder service, runs only on an empty database) ---
SEED_ADMINS=10
SEED_CUSTOMERS=200
SEED_CARTYPES=40
SEED_CARS=200
SEED_BOOKINGS=400

# --- Email ---
# By default all emails go to the local Mailpit server: read them at http://localhost:8025.
# To send real emails, set the SMTP server of your provider, for example Gmail:
#   MAIL_SMTP_HOST=smtp.gmail.com, MAIL_SMTP_PORT=587, MAIL_SMTP_STARTTLS=true,
#   MAIL_USERNAME=you@gmail.com, MAIL_APP_PASSWORD=<app password, see https://myaccount.google.com/apppasswords>
# Leave MAIL_SMTP_HOST empty to only write emails to the server log.
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_STARTTLS=false
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=no-reply@luxurycarrental.local
